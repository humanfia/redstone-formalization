/-- `BlockState.getFluidState()`: the fluid the block holds. Blocks of water and lava hold
their fluid, a block with the property `waterlogged` set holds a water source, and so do the
few blocks that only exist under water. -/
def fluidState : Block → FluidState
  | .plain i =>
    match i with
    | .seagrass | .kelp_plant => .source .water
    | _ => .empty
  | .mangrovePropagule s => .waterlogged s.waterlogged
  | .liquid i s =>
    match i with
    | .water => .ofLevel .water s.level.val
    | .lava => .ofLevel .lava s.level.val
  | .mangroveRoots s => .waterlogged s.waterlogged
  | .tintedParticleLeaves _ s => .waterlogged s.waterlogged
  | .leaves s => .waterlogged s.waterlogged
  | .untintedParticleLeaves _ s => .waterlogged s.waterlogged
  | .mangroveLeaves s => .waterlogged s.waterlogged
  | .poweredRail _ s => .waterlogged s.waterlogged
  | .detectorRail s => .waterlogged s.waterlogged
  | .tallSeagrass _ => .source .water
  | .stair _ s => .waterlogged s.waterlogged
