/-- Reads a state of the block `id` from its properties. -/
def ofProps? (id : BlockId) (get : String → Option String) : Option Block :=
  match id with
  | .air => some (.plain .air)
  | .stone => some (.plain .stone)
  | .granite => some (.plain .granite)
  | .polished_granite => some (.plain .polished_granite)
  | .diorite => some (.plain .diorite)
  | .polished_diorite => some (.plain .polished_diorite)
  | .andesite => some (.plain .andesite)
  | .polished_andesite => some (.plain .polished_andesite)
  | .grass_block => (.grass ·) <$> Blocks.Grass.ofProps? get
